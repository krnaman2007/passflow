PORT=5001
NODE_ENV=production
DATABASE_URL="postgresql://user:password@host:5432/passflow?schema=public"
# DIRECT_URL is required by Prisma schema. For direct DB connections (or standard Postgres), use the same connection string as DATABASE_URL. If using Neon/Supabase pooled connection, set to direct unpooled port 5432.
DIRECT_URL="postgresql://user:password@host:5432/passflow?schema=public"
JWT_SECRET="generate_a_secure_random_string_here_min_32_chars"
JWT_REFRESH_SECRET="generate_another_secure_random_string_here"
FRONTEND_URL="https://your-frontend-domain.vercel.app"
# Optional overrides:
# REDIS_URL="redis://localhost:6379"
# DB_CONNECT_TIMEOUT_MS=15000

