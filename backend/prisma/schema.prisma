// Prisma Schema for PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(uuid())
  name         String?
  email        String     @unique
  passwordHash String
  phone        String?
  profile      String?
  walletId     String?    @unique
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  organizer    Organizer?
  buyerSeller  BuyerSeller?
  orders       Order[]
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum CategoryStatus {
  ACTIVE
  SOLD_OUT
  CLOSED
}

enum OrderSide {
  BID
  ASK
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

model Organizer {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName   String
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())

  // Relationships
  events             Event[]
}

model BuyerSeller {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycStatus KycStatus @default(PENDING)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Event {
  id            String           @id @default(uuid())
  name          String
  description   String?
  dateTime      DateTime
  location      String
  organizerId   String
  organizer     Organizer        @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  status        EventStatus      @default(DRAFT)
  originalPrice Decimal?         @db.Decimal(12, 2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relationships
  categories    TicketCategory[]
  orders        Order[]
}

model TicketCategory {
  id                String           @id @default(uuid())
  eventId           String
  event             Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String
  originalPrice     Decimal          @db.Decimal(12, 2)
  totalQuantity     Int
  availableQuantity Int
  status            CategoryStatus   @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relationships
  inventory         TicketInventory?
  orders            Order[]
}

model TicketInventory {
  id                String         @id @default(uuid())
  categoryId        String         @unique
  category          TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  totalQuantity     Int
  availableQuantity Int
  reservedQuantity  Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Order {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId           String
  event             Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketCategoryId  String
  ticketCategory    TicketCategory @relation(fields: [ticketCategoryId], references: [id], onDelete: Cascade)
  side              OrderSide
  status            OrderStatus    @default(OPEN)
  price             Int            // Integer minor currency units / ticks (e.g. cents)
  initialQuantity   Int            // Original requested size
  remainingQuantity Int            // Unfilled quantity resting in the market
  idempotencyKey    String?        // Client-provided deduplication token
  stoppedReason     String?        // Recorded reason matching stopped (e.g. 'SELF_TRADE_PREVENTION')
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relationships
  incomingExecutions Execution[]   @relation("IncomingOrderExecutions")
  restingExecutions  Execution[]   @relation("RestingOrderExecutions")

  // Constraints & Indexes
  @@unique([userId, idempotencyKey])
  @@index([eventId, ticketCategoryId, status, price, createdAt])
  @@index([userId, createdAt])
}

model Execution {
  id              String   @id @default(uuid())
  incomingOrderId String
  incomingOrder   Order    @relation("IncomingOrderExecutions", fields: [incomingOrderId], references: [id], onDelete: Cascade)
  restingOrderId  String
  restingOrder    Order    @relation("RestingOrderExecutions", fields: [restingOrderId], references: [id], onDelete: Cascade)
  price           Int      // Integer execution price (passive resting order price in ticks/cents)
  quantity        Int      // Executed quantity
  sequenceNumber  BigInt   @default(autoincrement())
  executedAt      DateTime @default(now())

  // Indexes for order history reconstruction and audit
  @@index([incomingOrderId])
  @@index([restingOrderId])
  @@index([sequenceNumber])
}

