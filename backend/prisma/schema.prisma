// Prisma Schema for PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(uuid())
  name         String?
  email        String     @unique
  passwordHash String
  phone        String?
  profile      String?
  walletId     String?    @unique
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  organizer    Organizer?
  buyerSeller  BuyerSeller?
  orders       Order[]
  wallet       Wallet?
  refreshTokens RefreshToken[]
  admin        Admin?
  ticketInventories UserTicketInventory[]
  inventoryCredits  UserInventoryCredit[]
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum CategoryStatus {
  ACTIVE
  SOLD_OUT
  CLOSED
}

enum OrderSide {
  BID
  ASK
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

enum HoldStatus {
  ACTIVE
  PARTIALLY_RELEASED
  PARTIALLY_SETTLED
  SETTLED
  RELEASED
}

enum HoldReason {
  ORDER_ESCROW
  WITHDRAWAL_ESCROW
  ADMINISTRATIVE_HOLD
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL_LOCK
  WITHDRAWAL_SETTLED
  WITHDRAWAL_REFUNDED
  ORDER_HOLD
  ORDER_RELEASE
  TRADE_SETTLEMENT_DEBIT
  TRADE_SETTLEMENT_CREDIT
  FEE_DEBIT
  COMPENSATING_ADJUSTMENT
}

enum FinancialOperationType {
  DEPOSIT
  WITHDRAWAL
  ORDER_ESCROW
  ORDER_RELEASE
  TRADE_SETTLEMENT
  REFUND
  COMPENSATING_ADJUSTMENT
}

enum FinancialOperationStatus {
  PENDING
  COMPLETED
  FAILED
}

model Organizer {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName   String
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())

  // Relationships
  events             Event[]
}

model BuyerSeller {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycStatus KycStatus @default(PENDING)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Event {
  id            String           @id @default(uuid())
  name          String
  description   String?
  dateTime      DateTime
  location      String
  organizerId   String
  organizer     Organizer        @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  status        EventStatus      @default(DRAFT)
  originalPrice Decimal?         @db.Decimal(12, 2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relationships
  categories    TicketCategory[]
  orders        Order[]
}

model TicketCategory {
  id                String           @id @default(uuid())
  eventId           String
  event             Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String
  originalPrice     Decimal          @db.Decimal(12, 2)
  totalQuantity     Int
  availableQuantity Int
  status            CategoryStatus   @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relationships
  inventory         TicketInventory?
  orders            Order[]
  userInventories   UserTicketInventory[]
  inventoryCredits  UserInventoryCredit[]
}

model TicketInventory {
  id                String         @id @default(uuid())
  categoryId        String         @unique
  category          TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  totalQuantity     Int
  availableQuantity Int
  reservedQuantity  Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model UserTicketInventory {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketCategoryId  String
  ticketCategory    TicketCategory @relation(fields: [ticketCategoryId], references: [id], onDelete: Cascade)
  totalQuantity     Int            @default(0)
  availableQuantity Int            @default(0)
  reservedQuantity  Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([userId, ticketCategoryId])
  @@index([userId])
  @@index([ticketCategoryId])
}

model UserInventoryCredit {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketCategoryId String
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id], onDelete: Cascade)
  quantity         Int
  idempotencyKey   String         @unique
  purchaseId       String?
  createdAt        DateTime       @default(now())

  @@index([userId, ticketCategoryId])
  @@index([idempotencyKey])
}

model Order {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId           String
  event             Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketCategoryId  String
  ticketCategory    TicketCategory @relation(fields: [ticketCategoryId], references: [id], onDelete: Cascade)
  side              OrderSide
  status            OrderStatus    @default(OPEN)
  price             Int            // Integer minor currency units / ticks (e.g. cents)
  initialQuantity   Int            // Original requested size
  remainingQuantity Int            // Unfilled quantity resting in the market
  idempotencyKey    String?        // Client-provided deduplication token
  stoppedReason     String?        // Recorded reason matching stopped (e.g. 'SELF_TRADE_PREVENTION')
  sequenceNumber    BigInt         @unique @default(autoincrement())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relationships
  incomingExecutions Execution[]   @relation("IncomingOrderExecutions")
  restingExecutions  Execution[]   @relation("RestingOrderExecutions")
  buySettlements     TradeSettlement[] @relation("SettlementBuyOrder")
  sellSettlements    TradeSettlement[] @relation("SettlementSellOrder")
  ledgerEntries      WalletLedgerEntry[]
  holds              WalletHold[]

  // Constraints & Indexes
  @@unique([userId, idempotencyKey])
  @@index([eventId, ticketCategoryId, status, price, sequenceNumber])
  @@index([eventId, ticketCategoryId, status, price, createdAt])
  @@index([userId, createdAt])
}

model Execution {
  id              String   @id @default(uuid())
  incomingOrderId String
  incomingOrder   Order    @relation("IncomingOrderExecutions", fields: [incomingOrderId], references: [id], onDelete: Restrict)
  restingOrderId  String
  restingOrder    Order    @relation("RestingOrderExecutions", fields: [restingOrderId], references: [id], onDelete: Restrict)
  price           Int      // Integer execution price (passive resting order price in ticks/cents)
  quantity        Int      // Executed quantity
  sequenceNumber  BigInt   @default(autoincrement())
  executedAt      DateTime @default(now())

  // Relationships
  ledgerEntries   WalletLedgerEntry[]
  settlement      TradeSettlement?

  // Indexes for order history reconstruction and audit
  @@index([incomingOrderId])
  @@index([restingOrderId])
  @@index([sequenceNumber])
}

// One immutable, completed accounting result per execution.  This is both the
// durable settlement receipt and the concurrency/idempotency guard.
model TradeSettlement {
  id                    String    @id @default(uuid())
  executionId           String    @unique
  execution             Execution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  buyerOrderId          String
  buyerOrder            Order     @relation("SettlementBuyOrder", fields: [buyerOrderId], references: [id], onDelete: Restrict)
  sellerOrderId         String
  sellerOrder           Order     @relation("SettlementSellOrder", fields: [sellerOrderId], references: [id], onDelete: Restrict)
  buyerHoldId           String
  buyerHold             WalletHold @relation(fields: [buyerHoldId], references: [id], onDelete: Restrict)
  quantity              Int
  executionPricePaise   Int
  executionCostPaise    BigInt
  buyerReservedConsumed BigInt
  priceImprovementPaise BigInt
  createdAt             DateTime  @default(now())

  @@index([createdAt])
}

model Wallet {
  id               String              @id @default(uuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  currency         String              @default("INR")
  availableBalance BigInt              @default(0) // Available funds in minor units (paise)
  reservedBalance  BigInt              @default(0) // Held/escrowed funds in minor units (paise)
  version          BigInt              @default(0) // Optimistic concurrency control sequence
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relationships
  ledgerEntries    WalletLedgerEntry[]
  holds            WalletHold[]

  @@index([userId])
}

model FinancialOperation {
  id             String                   @id @default(uuid())
  idempotencyKey String                   @unique
  operationType  FinancialOperationType
  status         FinancialOperationStatus @default(PENDING)
  referenceType  String?                  // e.g. 'ORDER', 'EXECUTION', 'PAYMENT_INTENT'
  referenceId    String?                  // ID of referencing domain entity
  description    String?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  // Relationships
  ledgerEntries  WalletLedgerEntry[]
  holds          WalletHold[]

  @@index([operationType, status])
  @@index([referenceType, referenceId])
}

model WalletHold {
  id              String              @id @default(uuid())
  walletId        String
  wallet          Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  operationId     String?
  operation       FinancialOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
  orderId         String?
  order           Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reason          HoldReason          @default(ORDER_ESCROW)
  status          HoldStatus          @default(ACTIVE)
  heldAmount      BigInt              // Total initial reservation in paise
  remainingAmount BigInt              // Currently active reservation in paise
  idempotencyKey  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relationships
  ledgerEntries   WalletLedgerEntry[]
  settlements     TradeSettlement[]

  @@unique([walletId, idempotencyKey])
  @@index([walletId, status])
  @@index([orderId])
  @@index([operationId])
}

model WalletLedgerEntry {
  id                    String              @id @default(uuid())
  walletId              String
  wallet                Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  operationId           String?
  operation             FinancialOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
  sequenceNumber        BigInt              @unique @default(autoincrement())
  entryType             LedgerEntryType
  amount                BigInt              // Absolute monetary amount in paise (> 0)
  availableDelta        BigInt              // Signed change to availableBalance
  reservedDelta         BigInt              // Signed change to reservedBalance
  balanceAfterAvailable BigInt              // Snapshot of availableBalance after entry
  balanceAfterReserved  BigInt              // Snapshot of reservedBalance after entry
  holdId                String?
  hold                  WalletHold?         @relation(fields: [holdId], references: [id], onDelete: Restrict)
  orderId               String?
  order                 Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  executionId           String?
  execution             Execution?          @relation(fields: [executionId], references: [id], onDelete: Restrict)
  idempotencyKey        String?
  description           String?
  createdAt             DateTime            @default(now())

  @@unique([walletId, idempotencyKey])
  @@index([walletId, sequenceNumber])
  @@index([walletId, createdAt])
  @@index([operationId])
  @@index([holdId])
  @@index([orderId])
  @@index([executionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([userId])
}

model Admin {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String     @unique
  role      Role       @default(ADMIN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relationships
  auditLogs AuditLog[]

  @@index([email])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action    String
  details   Json?
  timestamp DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([timestamp])
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  DISCREPANCY_FOUND
  FAILED
}

model Reconciliation {
  id        String               @id @default(uuid())
  date      DateTime             @default(now())
  status    ReconciliationStatus @default(PENDING)
  reportUrl String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([date])
  @@index([status])
}

enum MonitoringStatus {
  HEALTHY
  DEGRADED
  DOWN
  INFO
  WARNING
  ERROR
}

model Monitoring {
  id        String           @id @default(uuid())
  type      String
  details   Json?
  status    MonitoringStatus @default(HEALTHY)
  createdAt DateTime         @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
}


